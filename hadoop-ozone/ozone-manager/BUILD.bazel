# AspectJ compile-time weaving: tools/bazel/aspectj.bzl (Maven parity pending).

load("@rules_java//java:defs.bzl", "java_library", "java_plugin")

java_plugin(
    name = "om_annotation_processing",
    processor_class = "org.apache.hadoop.hdds.conf.ConfigFileGenerator",
    deps = [
        "//hadoop-hdds/annotations:hdds-annotation-processing",
        "//hadoop-hdds/config:hdds-config",
    ],
)

java_library(
    name = "ozone-manager",
    srcs = glob(["src/main/java/**/*.java"]),
    resources = glob(["src/main/resources/**"]),
    plugins = [":om_annotation_processing"],
    deps = [
        "//hadoop-hdds/cli-common:hdds-cli-common",
        "//hadoop-hdds/client:hdds-client",
        "//hadoop-hdds/common:hdds-common",
        "//hadoop-hdds/config:hdds-config",
        "//hadoop-hdds/framework:hdds-server-framework",
        "//hadoop-hdds/interface-client:hdds-interface-client",
        "//hadoop-hdds/interface-server:hdds-interface-server",
        "//hadoop-hdds/managed-rocksdb:hdds-managed-rocksdb",
        "//hadoop-hdds/rocks-native:hdds-rocks-native",
        "//hadoop-hdds/rocksdb-checkpoint-differ:rocksdb-checkpoint-differ",
        "//hadoop-ozone/common:ozone-common",
        "//hadoop-ozone/interface-client:ozone-interface-client",
        "//hadoop-ozone/interface-storage:ozone-interface-storage",
        "@maven//:com_fasterxml_jackson_core_jackson_annotations",
        "@maven//:com_fasterxml_jackson_core_jackson_databind",
        "@maven//:com_google_guava_guava",
        "@maven//:com_google_protobuf_protobuf_java",
        "@maven//:commons_codec_commons_codec",
        "@maven//:commons_io_commons_io",
        "@maven//:info_picocli_picocli",
        "@maven//:io_grpc_grpc_api",
        "@maven//:io_grpc_grpc_netty",
        "@maven//:io_grpc_grpc_protobuf",
        "@maven//:io_grpc_grpc_stub",
        "@maven//:io_netty_netty_common",
        "@maven//:io_netty_netty_handler",
        "@maven//:io_netty_netty_transport",
        "@maven//:jakarta_annotation_jakarta_annotation_api",
        "@maven//:javax_servlet_javax_servlet_api",
        "@maven//:org_apache_commons_commons_compress",
        "@maven//:org_apache_commons_commons_lang3",
        "@maven//:org_apache_commons_commons_pool2",
        "@maven//:org_apache_hadoop_hadoop_auth",
        "@maven//:org_apache_hadoop_hadoop_common",
        "@maven//:org_apache_hadoop_hadoop_hdfs_client",
        "@maven//:org_apache_kerby_kerby_util",
        "@maven//:org_apache_logging_log4j_log4j_api",
        "@maven//:org_apache_ratis_ratis_common",
        "@maven//:org_apache_ratis_ratis_grpc",
        "@maven//:org_apache_ratis_ratis_netty",
        "@maven//:org_apache_ratis_ratis_proto",
        "@maven//:org_apache_ratis_ratis_server",
        "@maven//:org_apache_ratis_ratis_server_api",
        "@maven//:org_apache_ratis_ratis_thirdparty_misc",
        "@maven//:org_aspectj_aspectjrt",
        "@maven//:org_eclipse_jetty_jetty_webapp",
        "@maven//:org_reflections_reflections",
        "@maven//:org_rocksdb_rocksdbjni",
        "@maven//:org_slf4j_slf4j_api",
        "@maven//:org_yaml_snakeyaml",
    ],
    visibility = ["//visibility:public"],
)

java_library(
    name = "ozone-manager-tests",
    testonly = True,
    tags = ["manual"],
    srcs = glob(["src/test/java/**/*.java"], allow_empty = True),
    resources = glob(["src/test/resources/**"], allow_empty = True),
    deps = [
        ":ozone-manager",
        "//hadoop-hdds/test-utils:hdds-test-utils",
        "@maven//:org_assertj_assertj_core",
        "@maven//:org_junit_jupiter_junit_jupiter_api",
        "@maven//:org_mockito_mockito_core",
        "@maven//:org_mockito_mockito_junit_jupiter",
    ],
    visibility = ["//visibility:public"],
)
