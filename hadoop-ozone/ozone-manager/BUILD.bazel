load("//tools/bazel:aspectj.bzl", "aspectj_library")

# Compile-time woven aspects (see src/main/resources/META-INF/aop.xml).
aspectj_library(
    name = "ozone-manager-aspectj",
    srcs = glob(["src/main/java/**/*.java"]),
    aspects = glob(["src/main/java/**/*Aspect.java"]),
    resources = glob(["src/main/resources/**"]),
    aop_xml = "src/main/resources/META-INF/aop.xml",
    deps = [],  # Wire OM module deps as Bazel graph expands.
    tags = ["manual"],
    visibility = ["//visibility:public"],
)
