load("@rules_java//java:defs.bzl", "java_library")
load("//tools/bazel:junit5.bzl", "ozone_junit5_package")

package(default_visibility = ["//visibility:public"])

java_library(
    name = "ozone-multitenancy-ranger",
    srcs = glob(["src/main/java/**/*.java"], allow_empty = True),
    resources = glob(["src/main/resources/**"], allow_empty = True),
    tags = ["manual"],
    deps = [
        "//hadoop-hdds/common:hdds-common",
        "//hadoop-hdds/config:hdds-config",
        "//hadoop-ozone/common:ozone-common",
        "//hadoop-ozone/ozone-manager:ozone-manager",
        "@maven//:com_sun_jersey_jersey_client",
        "@maven//:org_apache_hadoop_hadoop_client_api",
        "@maven//:org_apache_hadoop_hadoop_common",
        "@maven//:org_apache_ranger_ranger_intg",
        "@maven//:org_apache_ranger_ranger_plugins_common",
        "@maven//:org_slf4j_slf4j_api",
    ],
)

java_library(
    name = "ozone-multitenancy-ranger-tests",
    testonly = True,
    srcs = glob(["src/test/java/**/*.java"], allow_empty = True),
    resources = glob(["src/test/resources/**"], allow_empty = True),
    tags = ["manual"],
    deps = [
        ":ozone-multitenancy-ranger",
        "//hadoop-hdds/common:hdds-common-tests",
        "//hadoop-hdds/config:hdds-config-tests",
        "//hadoop-hdds/test-utils:hdds-test-utils",
        "//hadoop-ozone/ozone-manager:ozone-manager-tests",
        "@maven//:org_apache_hadoop_hadoop_auth",
        "@maven//:org_apache_hadoop_hadoop_common",
        "@maven//:org_assertj_assertj_core",
        "@maven//:org_junit_jupiter_junit_jupiter_api",
        "@maven//:org_junit_jupiter_junit_jupiter_params",
    ],
)

# OZONE_JUNIT5_WIRED

ozone_junit5_package(
    name = "ozone-multitenancy-ranger-tests-pkg-org-apache-hadoop-ozone-om-multitenant",
    package = "org.apache.hadoop.ozone.om.multitenant",
    size = "large",
    tags = ["unit", "manual"],
    deps = [":ozone-multitenancy-ranger-tests"],
)

