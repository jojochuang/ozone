load("@rules_java//java:defs.bzl", "java_library")
load("//tools/bazel:junit5.bzl", "ozone_junit5_package")

package(default_visibility = ["//visibility:public"])

java_library(
    name = "ozone-cli-repair",
    srcs = glob(["src/main/java/**/*.java"], allow_empty = True),
    resources = glob(["src/main/resources/**"], allow_empty = True),
    deps = [
        "//hadoop-hdds/cli-common:hdds-cli-common",
        "//hadoop-hdds/common:hdds-common",
        "//hadoop-hdds/config:hdds-config",
        "//hadoop-hdds/container-service:hdds-container-service",
        "//hadoop-hdds/framework:hdds-server-framework",
        "//hadoop-hdds/interface-client:hdds-interface-client",
        "//hadoop-hdds/managed-rocksdb:hdds-managed-rocksdb",
        "//hadoop-hdds/server-scm:hdds-server-scm",
        "//hadoop-ozone/cli-debug:ozone-cli-debug",
        "//hadoop-ozone/cli-shell:ozone-cli-shell",
        "//hadoop-ozone/client:ozone-client",
        "//hadoop-ozone/common:ozone-common",
        "//hadoop-ozone/interface-client:ozone-interface-client",
        "//hadoop-ozone/ozone-manager:ozone-manager",
        "@maven//:com_google_guava_guava",
        "@maven//:commons_io_commons_io",
        "@maven//:info_picocli_picocli",
        "@maven//:jakarta_annotation_jakarta_annotation_api",
        "@maven//:org_apache_commons_commons_lang3",
        "@maven//:org_apache_hadoop_hadoop_common",
        "@maven//:org_apache_ratis_ratis_common",
        "@maven//:org_apache_ratis_ratis_proto",
        "@maven//:org_apache_ratis_ratis_server",
        "@maven//:org_apache_ratis_ratis_server_api",
        "@maven//:org_apache_ratis_ratis_thirdparty_misc",
        "@maven//:org_kohsuke_metainf_services_metainf_services",
        "@maven//:org_rocksdb_rocksdbjni",
        "@maven//:org_slf4j_slf4j_api",
    ],
)

java_library(
    name = "ozone-cli-repair-tests",
    testonly = True,
    tags = ["manual"],
    srcs = glob(["src/test/java/**/*.java"], allow_empty = True),
    resources = glob(["src/test/resources/**"], allow_empty = True),
    deps = [
        ":ozone-cli-repair",
        "//hadoop-hdds/common:hdds-common-tests",
        "//hadoop-hdds/container-service:hdds-container-service-tests",
        "//hadoop-hdds/framework:hdds-server-framework-tests",
        "//hadoop-hdds/test-utils:hdds-test-utils",
        "@maven//:org_assertj_assertj_core",
        "@maven//:org_junit_jupiter_junit_jupiter_api",
        "@maven//:org_junit_jupiter_junit_jupiter_params",
        "@maven//:org_mockito_mockito_core",
        "@maven//:org_mockito_mockito_junit_jupiter",
    ],
)

# OZONE_JUNIT5_WIRED

ozone_junit5_package(
    name = "ozone-cli-repair-tests-pkg-org-apache-hadoop-ozone-repair",
    package = "org.apache.hadoop.ozone.repair",
    size = "large",
    tags = ["unit", "manual"],
    deps = [":ozone-cli-repair-tests"],
)

ozone_junit5_package(
    name = "ozone-cli-repair-tests-pkg-org-apache-hadoop-ozone-repair-datanode-schemaupgrade",
    package = "org.apache.hadoop.ozone.repair.datanode.schemaupgrade",
    size = "large",
    tags = ["unit", "manual"],
    deps = [":ozone-cli-repair-tests"],
)

ozone_junit5_package(
    name = "ozone-cli-repair-tests-pkg-org-apache-hadoop-ozone-repair-ldb",
    package = "org.apache.hadoop.ozone.repair.ldb",
    size = "large",
    tags = ["unit", "manual"],
    deps = [":ozone-cli-repair-tests"],
)

ozone_junit5_package(
    name = "ozone-cli-repair-tests-pkg-org-apache-hadoop-ozone-repair-om",
    package = "org.apache.hadoop.ozone.repair.om",
    size = "large",
    tags = ["unit", "manual"],
    deps = [":ozone-cli-repair-tests"],
)

