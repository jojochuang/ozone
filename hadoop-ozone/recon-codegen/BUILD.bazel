load("@rules_java//java:defs.bzl", "java_binary", "java_library")

_RECON_CODEGEN_DEPS = [
    "@maven//:org_apache_derby_derby",
    "@maven//:org_jooq_jooq",
    "@maven//:org_jooq_jooq_codegen",
    "@maven//:org_jooq_jooq_meta",
    "@maven//:org_apache_hadoop_hadoop_common",
    "@maven//:com_google_inject_guice",
    "@maven//:commons_io_commons_io",
    "@maven//:org_slf4j_slf4j_api",
    "@maven//:org_springframework_spring_tx",
]

java_library(
    name = "recon-codegen-lib",
    srcs = glob(["src/main/java/**/*.java"]),
    deps = _RECON_CODEGEN_DEPS,
    visibility = ["//visibility:public"],
)

java_binary(
    name = "ozone-reconcodegen",
    main_class = "org.apache.ozone.recon.codegen.JooqCodeGenerator",
    tags = ["manual"],
    runtime_deps = [":recon-codegen-lib"],
    visibility = ["//visibility:public"],
)

genrule(
    name = "recon_jooq_codegen",
    tools = [":ozone-reconcodegen"],
    outs = ["recon-jooq-generated.srcjar"],
    cmd = """
set -euo pipefail
GEN=$$(mktemp -d)
$(location :ozone-reconcodegen) "$$GEN"
jar cf $(location recon-jooq-generated.srcjar) -C "$$GEN" .
""",
    tags = ["manual"],
)

java_library(
    name = "recon-jooq-generated",
    srcs = [":recon_jooq_codegen"],
    deps = [
        "@maven//:org_jooq_jooq",
        "@maven//:org_apache_hadoop_hadoop_common",
    ],
    visibility = ["//visibility:public"],
)
