load("@rules_java//java:defs.bzl", "java_library")
load("//tools/bazel:junit5.bzl", "ozone_junit5_package")

package(default_visibility = ["//visibility:public"])

java_library(
    name = "ozone-vapor",
    srcs = glob(["src/main/java/**/*.java"], allow_empty = True),
    resources = glob(["src/main/resources/**"], allow_empty = True),
    deps = [
        "//hadoop-hdds/cli-common:hdds-cli-common",
        "//hadoop-hdds/client:hdds-client",
        "//hadoop-hdds/common:hdds-common",
        "//hadoop-hdds/config:hdds-config",
        "//hadoop-hdds/container-service:hdds-container-service",
        "//hadoop-hdds/framework:hdds-server-framework",
        "//hadoop-hdds/interface-client:hdds-interface-client",
        "//hadoop-hdds/interface-server:hdds-interface-server",
        "//hadoop-hdds/server-scm:hdds-server-scm",
        "//hadoop-ozone/common:ozone-common",
        "//hadoop-ozone/freon:ozone-freon",
        "//hadoop-ozone/interface-storage:ozone-interface-storage",
        "//hadoop-ozone/ozone-manager:ozone-manager",
        "@maven//:com_fasterxml_jackson_core_jackson_core",
        "@maven//:com_fasterxml_jackson_core_jackson_databind",
        "@maven//:com_google_guava_guava",
        "@maven//:com_google_protobuf_protobuf_java",
        "@maven//:commons_io_commons_io",
        "@maven//:info_picocli_picocli",
        "@maven//:io_dropwizard_metrics_metrics_core",
        "@maven//:org_apache_commons_commons_lang3",
        "@maven//:org_apache_hadoop_hadoop_common",
        "@maven//:org_apache_hadoop_hadoop_hdfs",
        "@maven//:org_apache_httpcomponents_httpclient",
        "@maven//:org_apache_httpcomponents_httpcore",
        "@maven//:org_apache_ratis_ratis_client",
        "@maven//:org_apache_ratis_ratis_common",
        "@maven//:org_apache_ratis_ratis_proto",
        "@maven//:org_apache_ratis_ratis_thirdparty_misc",
        "@maven//:org_kohsuke_metainf_services_metainf_services",
        "@maven//:org_slf4j_slf4j_api",
    ],
)

java_library(
    name = "ozone-vapor-tests",
    testonly = True,
    tags = ["manual"],
    srcs = glob(["src/test/java/**/*.java"], allow_empty = True),
    resources = glob(["src/test/resources/**"], allow_empty = True),
    deps = [
        ":ozone-vapor",
        "@maven//:org_assertj_assertj_core",
        "@maven//:org_junit_jupiter_junit_jupiter_api",
        "@maven//:org_junit_jupiter_junit_jupiter_params",
        "@maven//:org_mockito_mockito_core",
        "@maven//:org_mockito_mockito_junit_jupiter",
    ],
)

# OZONE_JUNIT5_WIRED

ozone_junit5_package(
    name = "ozone-vapor-tests-pkg-org-apache-hadoop-ozone-freon-containergenerator",
    package = "org.apache.hadoop.ozone.freon.containergenerator",
    size = "large",
    tags = ["unit", "manual"],
    deps = [":ozone-vapor-tests"],
)

