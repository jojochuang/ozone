# OZONE_BAZEL_GENERATED — refresh with tools/bazel/generate_build_files.py

load("//tools/bazel:junit5.bzl", "ozone_junit5_package")
load("@rules_java//java:defs.bzl", "java_library", "java_test")

package(default_visibility = ["//visibility:public"])

java_library(
    name = "ozone-integration-test-recon",
    testonly = True,
    tags = ["manual"],
    exports = [
        "//hadoop-hdds/common:hdds-common-tests",
        "//hadoop-hdds/server-scm:hdds-server-scm-tests",
        "//hadoop-ozone/cli-admin:ozone-cli-admin",
        "//hadoop-ozone/integration-test:ozone-integration-test",
        "//hadoop-ozone/integration-test:ozone-integration-test-tests",
        "//hadoop-ozone/mini-cluster:ozone-mini-cluster",
        "//hadoop-ozone/ozone-manager:ozone-manager-tests",
        "//hadoop-ozone/recon:ozone-recon",
    ],
)

java_library(
    name = "ozone-integration-test-recon-tests",
    testonly = True,
    srcs = glob(["src/test/java/**/*.java"], allow_empty = True),
    resources = glob(["src/test/resources/**"], allow_empty = True),
    tags = ["ozone-maven-stub", "manual"],
    deps = [
        ":ozone-integration-test-recon",
        # After stub exports so integration-test TestOzoneContainer wins over HDDS homonym.
        "//hadoop-ozone/integration-test:ozone-integration-test-tests",
    ],
)

# OZONE_JUNIT5_WIRED

ozone_junit5_package(
    name = "ozone-integration-test-recon-tests-pkg-org-apache-hadoop-ozone-recon",
    package = "org.apache.hadoop.ozone.recon",
    size = "large",
    tags = ["integration", "manual"],
    deps = [":ozone-integration-test-recon-tests"],
)

