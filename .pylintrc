# Pylint settings for Apache Ozone (2-space Python, 120-char lines; matches .editorconfig Java style).
[MASTER]
extension-pkg-allow-list=defusedxml

[FORMAT]
indent-string='  '
max-line-length=120

[MESSAGES CONTROL]
disable=
    bad-indentation,
    missing-module-docstring,
    missing-function-docstring,
    missing-class-docstring,
    too-many-branches,
    too-many-statements,
    too-many-locals,
    too-many-arguments,
    too-many-return-statements,
    duplicate-code,
    consider-using-f-string,
    import-outside-toplevel,
    broad-exception-caught,
    unused-import,
    unused-argument
