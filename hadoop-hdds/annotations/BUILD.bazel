load("@rules_java//java:defs.bzl", "java_library", "java_plugin")

java_library(
    name = "hdds-annotation-processing",
    srcs = glob(["src/main/java/**/*.java"]),
    visibility = ["//visibility:public"],
)

java_plugin(
    name = "hdds_annotation_plugin",
    processor_class = "org.apache.ozone.annotations.OmRequestFeatureValidatorProcessor",
    deps = [":hdds-annotation-processing"],
)

java_plugin(
    name = "register_validator_plugin",
    processor_class = "org.apache.ozone.annotations.RegisterValidatorProcessor",
    deps = [":hdds-annotation-processing"],
)

java_plugin(
    name = "replicate_annotation_plugin",
    processor_class = "org.apache.ozone.annotations.ReplicateAnnotationProcessor",
    deps = [":hdds-annotation-processing"],
)
