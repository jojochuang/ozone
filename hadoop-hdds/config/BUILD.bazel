load("//tools/bazel:junit5.bzl", "ozone_junit5_package")
load("@rules_java//java:defs.bzl", "java_library", "java_plugin", "java_test")

java_plugin(
    name = "config_file_generator",
    processor_class = "org.apache.hadoop.hdds.conf.ConfigFileGenerator",
    deps = [":hdds-config"],
)

java_library(
    name = "hdds-config",
    srcs = glob(["src/main/java/**/*.java"]),
    deps = [
        "@maven//:org_apache_hadoop_hadoop_common",
        "@maven//:org_slf4j_slf4j_api",
    ],
    visibility = ["//visibility:public"],
)

java_library(
    name = "hdds-config-tests",
    testonly = True,
    srcs = glob(["src/test/java/**/*.java"]),
    javacopts = ["-proc:full"],
    plugins = [":config_file_generator"],
    deps = [
        ":hdds-config",
        "@maven//:com_google_guava_guava",
        "@maven//:org_assertj_assertj_core",
        "@maven//:org_junit_jupiter_junit_jupiter_api",
        "@maven//:org_junit_jupiter_junit_jupiter_params",
    ],
    visibility = ["//visibility:public"],
)

java_test(
    name = "TestConfigurationReflectionUtil",
    srcs = [
        "src/test/java/org/apache/hadoop/hdds/conf/ConfigurationExample.java",
        "src/test/java/org/apache/hadoop/hdds/conf/TestConfigurationReflectionUtil.java",
    ],
    args = ["--select-class=org.apache.hadoop.hdds.conf.TestConfigurationReflectionUtil"],
    main_class = "org.junit.platform.console.ConsoleLauncher",
    use_testrunner = False,
    deps = [
        ":hdds-config",
        "@maven//:com_google_guava_guava",
        "@maven//:org_junit_jupiter_junit_jupiter_api",
        "@maven//:org_junit_jupiter_junit_jupiter_engine",
        "@maven//:org_junit_jupiter_junit_jupiter_params",
        "@maven//:org_junit_platform_junit_platform_console",
        "@maven//:org_junit_platform_junit_platform_launcher",
    ],
)

# OZONE_JUNIT5_WIRED

ozone_junit5_package(
    name = "hdds-config-tests-pkg-org-apache-hadoop-hdds-conf",
    package = "org.apache.hadoop.hdds.conf",
    size = "large",
    tags = ["unit"],
    deps = [":hdds-config-tests"],
)

