# Jersey 1.x (via hadoop-common) conflicts with JAX-RS 2.x used by HDDS HTTP/Jersey 2.
maven.artifact(
    artifact = "hadoop-common",
    exclusions = [
        "com.sun.jersey:jersey-core",
        "com.sun.jersey:jersey-json",
        "com.sun.jersey:jersey-server",
        "com.sun.jersey:jersey-servlet",
        "javax.ws.rs:jsr311-api",
    ],
    group = "org.apache.hadoop",
    version = "3.4.3",
)

# Zookeeper pulls logback by default; Ozone uses reload4j (log4j 1.x). A second SLF4J
# binding sends DEBUG noise to stdout and breaks acceptance checks for "Failed".
maven.artifact(
    artifact = "zookeeper",
    exclusions = [
        "ch.qos.logback:logback-classic",
        "ch.qos.logback:logback-core",
    ],
    group = "org.apache.zookeeper",
    version = "3.8.6",
)

use_repo(maven, "maven")
